<div>
    <h1>Servicios Disponibles</h1>

    {{#if servicios.length}}
        <div class="card-grid">
            {{#each servicios}}
                {{> service-card}}
            {{/each}}
        </div>
    {{else}}
        <div class="empty-state">
            <p>No hay servicios disponibles en este momento.</p>
        </div>
    {{/if}}
</div>
