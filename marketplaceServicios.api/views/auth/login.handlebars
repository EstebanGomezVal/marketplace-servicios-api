<div class="form-box">
    <h1>Iniciar sesión</h1>

    {{> flash}}

    <form method="POST" action="/login" novalidate>
        <input type="hidden" name="next" value="{{next}}">

        <div class="field">
            <label for="correo">Correo</label>
            <input type="email" id="correo" name="correo" value="{{values.correo}}" autocomplete="email" required autofocus>
            {{#if errors.correo}}<p class="field-error">{{errors.correo}}</p>{{/if}}
        </div>

        <div class="field">
            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" autocomplete="current-password" required>
            {{#if errors.password}}<p class="field-error">{{errors.password}}</p>{{/if}}
            <p style="text-align: right; font-size: 0.85rem; margin-top: 0.35rem;"><a href="/olvide-password" style="color: var(--primary);">¿Olvidaste tu contraseña?</a></p>
        </div>

        <button type="submit" class="btn">Entrar</button>
    </form>

    {{#if googleEnabled}}
        <p class="form-footer" style="margin: 1rem 0 0.75rem;">o</p>
        <a href="/api/auth/google" class="btn btn-google">Continuar con Google</a>
    {{/if}}

    <p class="form-footer">¿No tienes cuenta? <a href="/registro">Regístrate</a></p>
</div>
