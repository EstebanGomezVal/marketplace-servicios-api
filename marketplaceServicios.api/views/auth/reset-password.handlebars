<div class="form-box">
    <h1>Nueva contraseña</h1>

    {{#if token}}
        <form method="POST" action="/restablecer-password" novalidate>
            <input type="hidden" name="token" value="{{token}}">

            <div class="field">
                <label for="password">Nueva contraseña (mínimo 8 caracteres)</label>
                <input type="password" id="password" name="password" autocomplete="new-password" minlength="8" required autofocus>
                {{#if errors.password}}<p class="field-error">{{errors.password}}</p>{{/if}}
            </div>

            <div class="field">
                <label for="confirmar">Repite la contraseña</label>
                <input type="password" id="confirmar" name="confirmar" autocomplete="new-password" required>
                {{#if errors.confirmar}}<p class="field-error">{{errors.confirmar}}</p>{{/if}}
            </div>

            <button type="submit" class="btn">Guardar contraseña</button>
        </form>
    {{else}}
        <div class="alert alert-error" role="alert">Falta el enlace de recuperación. Abre el enlace completo del correo.</div>
        <a href="/olvide-password" class="btn">Pedir un enlace nuevo</a>
    {{/if}}
</div>
