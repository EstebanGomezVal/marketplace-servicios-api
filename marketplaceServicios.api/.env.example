# Servidor
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Base de datos (obligatoria)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<base>

# Autenticación (obligatoria)
JWT_SECRET=
# JWT_EXPIRES_IN=1h

# Login con Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Correo (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
MAIL_FROM="Marketplace Servicios <no-reply@marketplace.local>"
MAIL_DISABLED=false

VERIFY_EMAIL_TTL_HOURS=24
RESET_PASSWORD_TTL_MINUTES=30

# Logs
LOG_LEVEL=info

# Seed
# SEED_ALLOW_PRODUCTION=true